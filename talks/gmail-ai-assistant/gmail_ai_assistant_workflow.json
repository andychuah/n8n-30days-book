        "operation": "create",
        "name": "={{ $json.name }}"
      },
      "id": "91e6ec52-2da0-46a7-8380-a684958cf591",
      "name": "建立 Gmail 標籤",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.1,
      "position": [-440, -180]
    }
  ],
